<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>

</head>

<body>

    <div class="container">
        <div class=" flex flex-col justify-center text-center opacity-85">
            <div class="flex-1">
                <h1 class="underline font-bold mt-3">fill the form for student </h1>

            </div>
            <div class=" flex-1 w-full">
                <form action="" class="space-y-4">
                    <div>
                        <label for="" class="block mb-2 mt-2 font-bold">Full Name</label>
                        <input type="text"
                            class="w-auto p-2 rounded bg-gray-300 border border-gray-600 focus:outline-none focus:border-green-400"
                            placeholder="enter name">
                    </div>
                    <div>
                        <label for="" class="block mb-2 font-bold">Phone Number</label>
                        <input type="text"
                            class="w-auto p-2 rounded bg-gray-300 border border-gray-600 focus:outline-none focus:border-green-400"
                            placeholder="enter phone">
                    </div>
                    <div>
                        <label for="" class="block mb-2 font-bold ">Email</label>
                        <input type="text"
                            class="w-auto p-2 rounded bg-gray-300 border border-gray-600 focus:outline-none focus:border-green-400"
                            placeholder="enter email">
                    </div>
                    <div>
                        <label for="" class="block mb-2 font-bold">course</label>
                        <input type="text"
                            class="w-auto p-2 rounded bg-gray-300 border border-gray-600 focus:outline-none focus:border-green-400"
                            placeholder="enter course">
                    </div>
                    <div>
                        <label for="" class="block mb-2 font-bold ">budget</label>
                        <input type="text"
                            class="w-auto p-2 rounded bg-gray-300 border border-gray-600 focus:outline-none focus:border-green-400"
                            placeholder="enter budget">
                    </div>
                    <button
                        class="bg-gradient-to-r from-green-400 to-blue-500 text-black hidden md:inline transform transition-transform duration-300 hover:scale-105 px-11 py-3 rounded-full">Send</button>
                </form>
            </div>

        </div>

    </div>
</body>

</html>