<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <!-- <script src="https://cdn.tailwindcss.com"></script> -->


</head>

<body>
    <h1 class="text-3xl underline underline-offset-2 font-bold decoration-sky-500 decoration-2 text-center p-2 my-2">Add
        The
        Member</h1>


    <div class=" flex items-center justify-center flex-col gap-3.5">
        <form action="/api/auth" method="post" class="border-l-2 max-w-2xl w-auto  ">
            <div class=" flex flex-wrap justify-between mx-2 my-3 gap-3 p-2   ">
                <div class=" flex flex-col w-[48%]">
                    <label for="" class="font-bold my-2">Full Name: </label>
                    <input type="text" placeholder="enter full name"
                        class="bg-gray-200  border-gray-600  rounded-lg p-1">

                </div>
                <div class=" flex flex-col w-[48%]">
                    <label for="" class="font-bold my-2">Email: </label>
                    <input type="text" placeholder="enter email" class=" bg-gray-200  border-gray-600 rounded-lg p-1">
                </div>
                <div class=" flex flex-col w-[48%] ">
                    <label for="" class="font-bold my-2">phone: </label>
                    <input type="text" placeholder="enter phone" class="bg-gray-200  border-gray-600 rounded-lg p-1">
                </div>
                <div class=" flex flex-col w-[48%]">
                    <label for="" class="font-bold my-2">Courses: </label>
                    <select name="service" id="" class="rounded-lg  p-1 bg-gray-200  border-gray-600" required>
                        <option value="">Selcet Below:-</option>
                        <option value="mern">MERN stack</option>
                        <option value="python">Python</option>
                        <option value="django">Django</option>
                        <option value="flutter">Flutter</option>
                    </select>
                </div>
                <div class=" flex flex-col w-[48%]">
                    <label for="" class="font-bold my-2">Budget: </label>
                    <input type="text" placeholder="enter budget" class=" bg-gray-200  border-gray-600 rounded-lg p-1 ">
                </div>
                <div class=" flex flex-col w-[48%]">
                    <label for="" class="font-bold my-2">Visiting Date: </label>
                    <input type="date" placeholder="enter visting date"
                        class="bg-gray-200  border-gray-600 rounded-lg p-1 ">
                </div>
                <button
                    class=" bg-gradient-to-r from-green-400 to-blue-400  px-6 py-2 w-fit transform transition-transform duration-200  hover:scale-105 rounded-full">Submit
                    Now</button>
            </div>
        </form>

    </div>
</body>

</html>